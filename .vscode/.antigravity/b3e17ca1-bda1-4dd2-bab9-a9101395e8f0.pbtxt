              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Evaluates if a pointer offset drift exceeds the 20-pixel cancellation threshold."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Public for deterministic unit testing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  fun isDriftExceeded(start: Offset, current: Offset, maxDeltaPx: Float = MAX_MOVEMENT_DELTA_PX): Boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val dx = current.x - start.x"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val dy = current.y - start.y"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val distance = sqrt((dx * dx + dy * dy).toDouble()).toFloat()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return distance > maxDeltaPx"
