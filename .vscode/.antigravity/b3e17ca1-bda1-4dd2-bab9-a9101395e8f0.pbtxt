    content: "      .padding(16.dp),\n    verticalArrangement = Arrangement.spacedBy(16.dp)\n  ) {\n    Text(\n      text = \"Settings & Disguise\",\n      style = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.Bold),\n      color = MaterialTheme.colorScheme.primary\n    )\n\n    // \"Call Gynecologist\" Simulated Call Card\n    Card(\n      modifier = Modifier\n        .fillMaxWidth()\n        .clip(RoundedCornerShape(16.dp))\n        .combinedClickable(\n          onClick = { onLaunchFakeCall(\"Mom\") },\n          onLongClick = { onLaunchFakeCall(\"Police\") }\n        )\n        .testTag(\"call_gynecologist_card\"),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primaryContainer)\n    ) {\n      Row(\n        modifier = Modifier.padding(16.dp),\n        verticalAlignment = Alignment.CenterVertically\n      ) {\n        Box(\n          modifier = Modifier.size(44.dp).clip(CircleShape).background(MaterialTheme.colorScheme.primary),\n          contentAlignment = Alignment.Center\n        ) {\n          Icon(Icons.Default.PhoneInTalk, contentDescription = null, tint = Color.White)\n        }\n        Spacer(modifier = Modifier.width(14.dp))\n        Column {\n          Text(\n            text = \"Call Gynecologist\",\n            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),\n            color = MaterialTheme.colorScheme.onPrimaryContainer\n          )\n          Text(\n            text = \"Tap for \'Mom\' \342\200\242 Long press for \'Police\' simulated call.\",\n            style = MaterialTheme.typography.bodySmall,\n            color = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.8f)\n          )\n        }\n      }\n    }\n\n    // Support Circle Contacts (up to 3)\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Row(\n          modifier = Modifier.fillMaxWidth(),\n          horizontalArrangement = Arrangement.SpaceBetween,\n          verticalAlignment = Alignment.CenterVertically\n        ) {\n          Text(\n            text = \"Support Circle (${contacts.size}/3)\",\n            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold)\n          )\n          if (contacts.size < 3) {\n            OutlinedButton(\n              onClick = {\n                nameInput = \"\"\n                phoneInput = \"\"\n                contactError = null\n                showAddDialog = true\n              },\n              modifier = Modifier.testTag(\"settings_add_contact_button\")\n            ) {\n              Icon(Icons.Default.Add, contentDescription = null, modifier = Modifier.size(16.dp))\n              Spacer(modifier = Modifier.width(4.dp))\n              Text(\"Add\")\n            }\n          }\n        }\n\n        Spacer(modifier = Modifier.height(10.dp))"
