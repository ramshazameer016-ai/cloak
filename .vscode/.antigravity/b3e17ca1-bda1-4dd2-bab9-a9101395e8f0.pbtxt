    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "b3e17ca1-bda1-4dd2-bab9-a9101395e8f0"
      step_index: 1
      cascade_id: "b3e17ca1-bda1-4dd2-bab9-a9101395e8f0"
