4\342\224\200\342\224\200 SmsDispatcher.kt         # Native SmsManager multipart dispatcher\n\342\224\202       \342\224\202       \342\224\224\342\224\200\342\224\200 WhatsAppRelay.kt         # wa.me emergency message launcher\n\342\224\202       \342\224\234\342\224\200\342\224\200 data/\n\342\224\202       \342\224\202   \342\224\234\342\224\200\342\224\200 local/\n\342\224\202       \342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 CloakDatabase.kt         # Room DB v2 (Contacts + Period entries)\n\342\224\202       \342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 dao/ContactDao.kt        # Contact DAO\n\342\224\202       \342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 dao/PeriodDao.kt         # Period logs DAO\n\342\224\202       \342\224\202   \342\224\202   \342\224\224\342\224\200\342\224\200 entity/                  # EmergencyContact & PeriodEntry entities\n\342\224\202       \342\224\202   \342\224\234\342\224\200\342\224\200 network/\n\342\224\202       \342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 BurnerNoteRepository.kt  # 6-digit code generator & RPC read_and_burn\n\342\224\202       \342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 SupabaseConfig.kt        # Public anon key configuration\n\342\224\202       \342\224\202   \342\224\202   \342\224\224\342\224\200\342\224\200 SupabaseSosRepository.kt # REST client for sessions, locations, audio\n\342\224\202       \342\224\202   \342\224\224\342\224\200\342\224\200 repository/\n\342\224\202       \342\224\202       \342\224\234\342\224\200\342\224\200 ContactRepository.kt     # 3-contact limit manager\n\342\224\202       \342\224\202       \342\224\224\342\224\200\342\224\200 PeriodRepository.kt      # Cycle math & 28-day prediction\n\342\224\202       \342\224\234\342\224\200\342\224\200 service/\n\342\224\202       \342\224\202   \342\224\224\342\224\200\342\224\200 SosForegroundService.kt      # Audio & location foreground service\n\342\224\202       \342\224\224\342\224\200\342\224\200 ui/\n\342\224\202           \342\224\234\342\224\200\342\224\200 auth/\n\342\224\202           \342\224\202   \342\224\234\342\224\200\342\224\200 KeypadScreen.kt          # Custom 4-digit keypad\n\342\224\202           \342\224\202   \342\224\224\342\224\200\342\224\200 PinSetupScreen.kt        # Dual PIN onboarding wizard\n\342\224\202           \342\224\234\342\224\200\342\224\200 fakesleep/\n\342\224\202           \342\224\202   \342\224\224\342\224\200\342\224\200 FakeSleepOverlay.kt      # 15s inactivity blackout & 3s hold unlock\n\342\224\202           \342\224\234\342\224\200\342\224\200 navigation/\n\342\224\202           \342\224\202   \342\224\234\342\224\200\342\224\200 AppNavHost.kt            # Navigation graph with back-handler security\n\342\224\202           \342\224\202   \342\224\224\342\224\200\342\224\200 Screen.kt                # Route definitions\n\342\224\202           \342\224\234\342\224\200\342\224\200 shield/\n\342\224\202           \342\224\202   \342\224\224\342\224\200\342\224\200 ShieldDashboardScreen.kt # Secret 3-tile dashboard (EXIF, Lockdown, Burner)\n\342\224\202           \342\224\234\342\224\200\342\224\200 theme/\n\342\224\202           \342\224\202   \342\224\234\342\224\200\342\224\200 Color.kt                 # Petal rose/blush palette\n\342\224\202           \342\224\202   \342\224\224\342\224\200\342\224\200 Theme.kt                 # Material 3 theme\n\342\224\202           \342\224\224\342\224\200\342\224\200 tracker/\n\342\224\202               \342\224\234\342\224\200\342\224\200 FakeCallScreen.kt        # Simulated incoming call (Mom / Police)\n\342\224\202               \342\224\224\342\224\200\342\224\200 TrackerMainScreen.kt     # Calendar, Log, Tips, Settings disguise\n\342\224\224\342\224\200\342\224\200 src/test/java/com/example/\n    \342\224\234\342\224\200\342\224\200 ExampleRobolectricTest.kt            # App name verification\n    \342\224\234\342\224\200\342\224\200 ExampleUnitTest.kt                   # Basic arithmetic sanity check\n    \342\224\234\342\224\200\342\224\200 Stage1SafetyEngineTest.kt            # PBKDF2, PIN separation, shake math, idempotency\n    \342\224\234\342\224\200\342\224\200 Stage2DisguiseAndGuardianTest.kt     # Cycle predictions, contact limits, Maps URLs\n    \342\224\224\342\224\200\342\224\200 Stage3DigitalShieldAndHardeningTest.kt # Gesture drift, burner codes, EXIF stripping\n```\n\n---\n\n## 7. Supabase Database Migrations & SQL Setup\n\nExecute this SQL migration in your Supabase SQL Editor to support live SOS sessions, audio uploads, and atomic Burner Notes:\n\n```sql\n-- 1. SOS SESSIONS\nCREATE TABLE IF NOT EXISTS public.sos_sessions (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    session_id TEXT NOT NULL UNIQUE,\n    trigger_source TEXT NOT NULL CHECK (trigger_source IN (\'duress_pin\', \'shake\', \'manual_test\')),\n    status TEXT NOT NULL DEFAULT \'active\' CHECK (status IN (\'active\', \'resolved\', \'cancelled\')),\n    created_at TIMESTAMPTZ NOT NULL DEFAULT timezone(\'utc\', now())\n);\nALTER TABLE public.sos_sessions ENABLE ROW LEVEL SECURITY;\nCREATE POLICY \"Anon write sessions\" ON public.sos_sessions FOR INSERT TO anon WITH CHECK (true);\nCREATE POLICY \"Deny anon read sessions\" ON public.sos_sessions FOR SELECT TO anon USING (false);\n\n-- 2. SOS LOCATIONS\nCREATE TABLE IF NOT EXISTS public.sos_locations (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    session_id TEXT NOT NULL,\n    latitude DOUBLE PRECISION NOT NULL,\n    longitude DOUBLE PRECISION NOT NULL,\n    accuracy REAL,\n    recorded_at TIMESTAMPTZ NOT NULL DEFAULT timezone(\'utc\', now())\n);\nALTER TABLE public.sos_locations ENABLE ROW LEVEL SECURITY;\nCREATE POLICY \"Anon write locations\" ON public.sos_locations FOR INSERT TO anon WITH CHECK (true);\nCREATE POLICY \"Deny anon read locations\" ON public.sos_locations FOR SELECT TO anon USING (false);\n\n-- 3. PRIVATE AUDIO STORAGE BUCKET\nINSERT INTO storage.buckets (id, name, public) \nVALUES (\'sos_audio\', \'sos_audio\', false)\nON CONFLICT (id) DO NOTHING;\n\nCREATE POLICY \"Anon upload audio chunks\" \nON storage.objects FOR INSERT TO anon \nWITH CHECK (bucket_id = \'sos_audio\');\n\n-- 4. BURNER NOTES TABLE\nCREATE TABLE IF NOT EXISTS public.burner_notes (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    access_code TEXT NOT NULL UNIQUE,\n    note_body TEXT NOT NULL,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT timezone(\'utc\', now()),\n    expires_at TIMESTAMPTZ NOT NULL DEFAULT (timezone(\'utc\', now()) + INTERVAL \'24 hours\')\n);\nALTER TABLE public.burner_notes ENABLE ROW LEVEL SECURITY;\nCREATE POLICY \"Anon insert notes\" ON public.burner_notes FOR INSERT TO anon WITH CHECK (char_length(access_code) = 6);\nCREATE POLICY \"Deny direct anon select\" ON public.burner_notes FOR SELECT TO anon USING (false);\n\n-- 5. ATOMIC READ-AND-BURN DATABASE FUNCTION\nCREATE OR REPLACE FUNCTION public.read_and_burn(p_code TEXT)\nRETURNS TABLE (note_content TEXT, is_valid BOOLEAN)\nLANGUAGE plpgsql\nSECURITY DEFINER\nAS $$\nDECLARE\n    v_note_body TEXT;\nBEGIN\n    DELETE FROM public.burner_notes\n    WHERE access_code = p_code\n      AND expires_at > timezone(\'utc\', now())\n    RETURNING note_body INTO v_note_body;\n\n    IF v_note_body IS NOT NULL THEN\n        RETURN QUERY SELECT v_note_body AS note_content, true AS is_valid;\n    ELSE\n        RETURN QUERY SELECT NULL::TEXT AS note_content, false AS is_valid;\n    END IF;\nEND;\n$$;\n```\n\n---\n\n## 8. Real-Device Installation & 90-Second Demo Script\n\n### PowerShell Commands to Test and Install\n```powershell\nSet-Location -Path \"D:\\CloakNative\"\n\n# Run full test suite\ngradle :app:testDebugUnitTest\n\n# Assemble debug APK\ngradle :app:assembleDebug\n\n# Install on USB-connected Android phone\nadb install -r app\\build\\outputs\\apk\\debug\\app-debug.apk\n```\n\n### 90-Second Live Demonstration Script\n\n1. **Launcher & Public Appearance (0:00\342\200\2230:15)**:\n   - Point to the Android home screen. Show the app labeled **Petal** with a pastel pink floral emblem.\n   - Tap to open: the custom 4-digit keypad appears asking for a \"health passcode\".\n2. **Normal Access (0:15\342\200\2230:30)**:\n   - Enter Normal PIN `1234`.\n   - The app unlocks into the **Petal** Period Tracker.\n   - Show the interactive Calendar marking cycle days in red and predicted days in light pink.\n   - Tap \"Log\" to toggle symptom chips (Cramps, Headache) and mood.\n   - Tap \"Tips\" to scroll through 15 evidence-based wellness tips.\n3. **Simulated Incoming Call (0:30\342\200\2230:40)**:\n   - Go to Settings, tap **Call Gynecologist**: an incoming phone call from \"Mom\" rings with realistic vibration.\n   - Long press: caller switches to \"Police\". Answer to show the live call timer, then decline.\n4. **Duress Trigger & Fake-Sleep (0:40\342\200\2231:05)**:\n   - Lock the app and enter the Duress PIN `9999`.\n   - Notice: the exact same Petal tracker opens with zero alert, dialog, or warning.\n   - In the background, `SosController` dispatches an emergency SMS with a Google Maps link (`https://maps.google.com/?q=...`) to Support Circle contacts and starts streaming 5s audio chunks.\n   - Stop touching the phone for 15 seconds: the screen transitions into a completely black **Fake-Sleep** screen.\n   - Hold the black screen for 3 seconds: the PIN pad appears. Enter Normal PIN `1234` to stop SOS safely.\n5. **Digital Shield (1:05\342\200\2231:30)**:\n   - Return to the Petal tracker. Press and hold the top-left flower logo for 3 seconds without moving.\n   - Feel the subtle haptic vibration pulse as the **Digital Shield** opens:\n     - **Photo Sanitizer**: Pick a photo, tap \"Strip EXIF\", and show the verified clean confirmation.\n     - **Digital Lockdown**: Tap \"Wi-Fi Panel\" to open the system panel shortcut.\n     - **Burner Notes**: Type a confidential note, generate a 6-digit code. Switch to \"Retrieve & Burn\" and enter the code. The note displays. Enter the code a second time to prove it was permanently destroyed on the server.\n   - Press the Android Home button: the Shield auto-closes, locking Petal back to its normal state.\n\n---\n\n## 9. Known Android Limitations\n\n1. **Silent Radio Toggling**: Android restricts third-party apps from silently disabling Wi-Fi/Bluetooth; Digital Lockdown provides compliant system panel shortcuts.\n2. **Background Microphone Restrictions**: On Android 14+, recording audio requires a foreground service started while the app is active, and Android displays a green system privacy indicator dot.\n3. **SMS Carrier Reliance**: Native emergency SMS delivery requires cellular coverage and an active SIM card; the app gracefully catches no-SIM and carrier failure states without crashing.\n4. **WhatsApp Automation**: WhatsApp does not allow third-party apps to send messages automatically in the background; `WhatsAppRelay` prepares the pre-filled message and requires one user tap to send."
