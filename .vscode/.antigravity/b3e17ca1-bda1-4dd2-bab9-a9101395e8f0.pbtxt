    tool_calls {
      id: "call_525214"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"package com.example.data.network\\n\\nimport android.content.Context\\nimport android.util.Log\\nimport kotlinx.coroutines.Dispatchers\\nimport kotlinx.coroutines.delay\\nimport kotlinx.coroutines.withContext\\nimport okhttp3.MediaType.Companion.toMediaType\\nimport okhttp3.OkHttpClient\\nimport okhttp3.Request\\nimport okhttp3.RequestBody.Companion.asRequestBody\\nimport okhttp3.RequestBody.Companion.toRequestBody\\nimport org.json.JSONObject\\nimport java.io.File\\nimport java.util.concurrent.TimeUnit\\n\\nclass SupabaseSosRepository(private val context: Context) {\\n\\n  companion object {\\n    private const val TAG = \\\"SupabaseSosRepo\\\"\\n    private const val MAX_RETRIES = 3\\n    private const val INITIAL_BACKOFF_MS = 1000L\\n  }\\n\\n  private val client = OkHttpClient.Builder()\\n    .connectTimeout(15, TimeUnit.SECONDS)\\n    .readTimeout(20, TimeUnit.SECONDS)\\n    .writeTimeout(30, TimeUnit.SECONDS)\\n    .build()\\n\\n  private val jsonMediaType = \\\"application/json; charset=utf-8\\\".toMediaType()\\n  private val audioMediaType = \\\"audio/mp4\\\".toMediaType()\\n\\n  private fun getBaseUrl(): String = SupabaseConfig.getSupabaseUrl(context).trimEnd(\'/\')\\n  private fun getAnonKey(): String = SupabaseConfig.getSupabaseAnonKey(context)\\n\\n  /**\\n   * Logs a new SOS session into Supabase \'sos_sessions\' table.\\n   */\\n  suspend fun recordSession(sessionId: String, triggerSource: String): Result<Unit> = withContext(Dispatchers.IO) {\\n    val url = \\\"${getBaseUrl()}/rest/v1/sos_sessions\\\"\\n    val json = JSONObject().apply {\\n      put(\\\"session_id\\\", sessionId)\\n      put(\\\"trigger_source\\\", triggerSource)\\n      put(\\\"status\\\", \\\"active\\\")\\n    }\\n\\n    executeWithRetry(\\\"recordSession\\\") {\\n      val request = Request.Builder()\\n        .url(url)\\n        .addHeader(\\\"apikey\\\", getAnonKey())\\n        .addHeader(\\\"Authorization\\\", \\\"Bearer ${getAnonKey()}\\\")\\n        .addHeader(\\\"Prefer\\\", \\\"resolution=merge-duplicates\\\")\\n        .post(json.toString().toRequestBody(jsonMediaType))\\n        .build()\\n\\n      client.newCall(request).execute().use { response ->\\n        if (response.isSuccessful || response.code == 409) {\\n          Result.success(Unit)\\n        } else {\\n          Result.failure(Exception(\\\"HTTP ${response.code}: ${response.body?.string()}\\\"))\\n        }\\n      }\\n    }\\n  }\\n\\n  /**\\n   * Logs a GPS coordinate into \'sos_locations\' table.\\n   */\\n  suspend fun recordLocation(\\n    sessionId: String,\\n    latitude: Double,\\n    longitude: Double,\\n    accuracy: Float?\\n  ): Result<Unit> = withContext(Dispatchers.IO) {\\n    val url = \\\"${getBaseUrl()}/rest/v1/sos_locations\\\"\\n    val json = JSONObject().apply {\\n      put(\\\"session_id\\\", sessionId)\\n      put(\\\"latitude\\\", latitude)\\n      put(\\\"longitude\\\", longitude)\\n      if (accuracy != null) put(\\\"accuracy\\\", accuracy)\\n    }\\n\\n    executeWithRetry(\\\"recordLocation\\\") {\\n      val request = Request.Builder()\\n        .url(url)\\n        .addHeader(\\\"apikey\\\", getAnonKey())\\n        .addHeader(\\\"Authorization\\\", \\\"Bearer ${getAnonKey()}\\\")\\n        .post(json.toString().toRequestBody(jsonMediaType))\\n        .build()\\n\\n      client.newCall(request).execute().use { response ->\\n        if (response.isSuccessful) {\\n          Result.success(Unit)\\n        } else {\\n          Result.failure(Exception(\\\"HTTP ${response.code}: ${response.body?.string()}\\\"))\\n        }\\n      }\\n    }\\n  }\\n\\n  /**\\n   * Uploads an audio chunk file to private Storage bucket \'sos_audio\'.\\n   */\\n  suspend fun uploadAudioChunk(\\n    sessionId: String,\\n    chunkIndex: Int,\\n    audioFile: File\\n  ): Result<String> = withContext(Dispatchers.IO) {\\n    if (!audioFile.exists() || audioFile.length() == 0L) {\\n      return@withContext Result.failure(IllegalArgumentException(\\\"Audio file is empty or missing.\\\"))\\n    }\\n\\n    val fileName = \\\"chunk_${chunkIndex}_${System.currentTimeMillis()}.m4a\\\"\\n    val storagePath = \\\"$sessionId/$fileName\\\"\\n    val url = \\\"${getBaseUrl()}/storage/v1/object/sos_audio/$storagePath\\\"\\n\\n    executeWithRetry(\\\"uploadAudioChunk[$chunkIndex]\\\") {\\n      val requestBody = audioFile.asRequestBody(audioMediaType)\\n      val request = Request.Builder()\\n        .url(url)\\n        .addHeader(\\\"apikey\\\", getAnonKey())\\n        .addHeader(\\\"Authorization\\\", \\\"Bearer ${getAnonKey()}\\\")\\n        .addHeader(\\\"x-upsert\\\", \\\"true\\\")\\n        .post(requestBody)\\n        .build()\\n\\n      client.newCall(request).execute().use { response ->\\n        if (response.isSuccessful) {\\n          Result.success(storagePath)\\n        } else {\\n          Result.failure(Exception(\\\"Upload failed with HTTP ${response.code}: ${response.body?.string()}\\\"))\\n        }\\n      }\\n    }\\n  }\\n\\n  private suspend fun <T> executeWithRetry(\\n    operationName: String,\\n    block: () -> Result<T>\\n  ): Result<T> {\\n    var currentDelay = INITIAL_BACKOFF_MS\\n    var lastError: Throwable = Exception(\\\"Operation $operationName failed\\\")\\n\\n    for (attempt in 1..MAX_RETRIES) {\\n      try {\\n        val result = block()\\n        if (result.isSuccess) return result\\n        result.exceptionOrNull()?.let { lastError = it }\\n      } catch (e: Exception) {\\n        lastError = e\\n        Log.w(TAG, \\\"$operationName attempt $attempt failed: ${e.message}\\\")\\n      }\\n\\n      if (attempt < MAX_RETRIES) {\\n        delay(currentDelay)\\n        currentDelay *= 2\\n      }\\n    }\\n    return Result.failure(lastError)\\n  }\\n}\\n\", \"Description\":\"Implement SupabaseSosRepository with session, location, and audio chunk uploads\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/data/network/SupabaseSosRepository.kt\", \"toolAction\":\"Writing SupabaseSosRepository\", \"toolSummary\":\"Create SupabaseSosRepository.kt\"}"
      thinking_signature: "\022\245\002\n\242\002\001i\024}\023C\352\216<\177\221\212Z\357+l\362\317\367\260tA\265p\333e\301>f\t\000\005G\t\362\225m\254\341Rc2/\336\326\357\024/^\337Ws\270\r\216lP\366gs-&!qg\346c\275o\250\227-\243C\255\262\302f\362\363\202\241\3318_J\201\n/=\223\216\\\273j\351\222T\nb\360\257\311\337!\371|\241<*\211@/\227\303\031\'\272\236\207*\245V\375rp\247\200\373\224\350\376R\034\310\261F\325;\241\006\'\346\213\253\316\206/\305C\200\337\357\275\341\212B\aA \252\275\336\302Dbf\260\376\331\030>KZ\370\334\n\a\256\250R\261\205\375/\342\350A\fr\277-\210^8\307\265\376\3729Y\2478\254\323\275u\0347g\360\326Q3\202\357\035E\351\210\017\003\20223\310G\200\245\307\255\005\233z7)\004\"\033\212\326\367\300} \247}r\345\201.\030I\\LY\254O<:\211\2445s\331|\232\306R\003\340\205\227V\3011=\353\245+\303\3220\034?\340\030\021o^"
