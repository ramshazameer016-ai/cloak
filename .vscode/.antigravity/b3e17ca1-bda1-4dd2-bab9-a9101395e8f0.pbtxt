  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/tracker/TrackerMainScreen.kt"
    start_line: 224
    end_line: 264
    content: "        }\n      }\n    }\n\n    // Layer 1 \"Call Gynecologist\" Simulated Incoming Call Overlay\n    if (showFakeCall) {\n      FakeCallScreen(\n        callerName = fakeCallerName,\n        onDismiss = { showFakeCall = false }\n      )\n    }\n\n    // Layer 2 Fake-Sleep 15-second Inactivity Black Screen during SOS\n    FakeSleepOverlay(\n      isSosActive = isSosActive,\n      pinStorage = pinStorage,\n      sosController = sosController,\n      inactivityThresholdMs = 15_000L,\n      onNormalPinUnlocked = {\n        // Normal PIN stops SOS and returns to tracker\n      },\n      onDuressPinUnlocked = {\n        // Duress PIN maintains SOS and returns to tracker\n      }\n    )\n  }\n}\n\n// -------------------------------------------------------------\n// TAB 1: CALENDAR (Mark period, predict next cycle, symptom dots)\n// -------------------------------------------------------------\n@Composable\nprivate fun CalendarTabView(periodRepository: PeriodRepository) {\n  val scope = rememberCoroutineScope()\n  var currentMonth by remember { mutableStateOf(YearMonth.now()) }\n  val entries by periodRepository.allEntriesFlow.collectAsState(initial = emptyList())\n  var predictedPeriod by remember { mutableStateOf<Pair<LocalDate, LocalDate>?>(null) }\n\n  LaunchedEffect(entries) {\n    predictedPeriod = periodRepository.predictNextPeriod()\n  }"
    num_lines: 853
    num_bytes: 33680
    line_range_bytes: 1319
  }
