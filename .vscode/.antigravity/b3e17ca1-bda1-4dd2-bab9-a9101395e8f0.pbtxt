              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        Spacer(modifier = Modifier.height(8.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val symptomList = listOf(\"Cramps\", \"Headache\", \"Bloating\", \"Fatigue\", \"Tender Breasts\", \"Acne\", \"Backache\", \"Cravings\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
