            lines {
              text: "    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      Column(modifier = Modifier.padding(16.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        Text(\"Flow Intensity\", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        Spacer(modifier = Modifier.height(8.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          listOf(\"None\", \"Light\", \"Medium\", \"Heavy\").forEach { level ->"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            FilterChip("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              selected = flowIntensity == level,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
