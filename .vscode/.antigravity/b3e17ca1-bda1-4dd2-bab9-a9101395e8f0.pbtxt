    content: "\n  // CRITICAL SECURITY REQUIREMENT:\n  // Automatically close Shield and return to root tracker when app backgrounds\n  DisposableEffect(lifecycleOwner) {\n    val observer = LifecycleEventObserver { _, event ->\n      if (event == LifecycleEvent.ON_STOP) {\n        onCloseShield()\n      }\n    }\n    lifecycleOwner.lifecycle.addObserver(observer)\n    onDispose {\n      lifecycleOwner.lifecycle.removeObserver(observer)\n    }\n  }\n\n  Surface(\n    modifier = Modifier.fillMaxSize().testTag(\"shield_dashboard_screen\"),\n    color = Color(0xFF141923) // High-security stealth palette"
