        target_content: "        OutlinedButton(onClick = {\n          pinStorage.clearAll()\n          onResetPins()\n        }) {\n          Text(\"Reset PINs\")\n        }\n      }\n    }\n  }"
        replacement_content: "        OutlinedButton(onClick = {\n          pinStorage.clearAll()\n          onResetPins()\n        }) {\n          Text(\"Reset PINs\")\n        }\n      }\n    }\n\n    // Guardian Protection Status Card (Discreet Verification in Settings)\n    Card(\n      modifier = Modifier\n        .fillMaxWidth()\n        .testTag(\"guardian_status_card\"),\n      colors = CardDefaults.cardColors(\n        containerColor = if (sosState is SosState.Active)\n          MaterialTheme.colorScheme.errorContainer.copy(alpha = 0.25f)\n        else MaterialTheme.colorScheme.surface\n      ),\n      shape = RoundedCornerShape(16.dp),\n      elevation = CardDefaults.cardElevation(defaultElevation = 1.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Row(\n          modifier = Modifier.fillMaxWidth(),\n          horizontalArrangement = Arrangement.SpaceBetween,\n          verticalAlignment = Alignment.CenterVertically\n        ) {\n          Row(verticalAlignment = Alignment.CenterVertically) {\n            Icon(\n              imageVector = if (sosState is SosState.Active) Icons.Default.NotificationsActive else Icons.Default.Security,\n              contentDescription = null,\n              tint = if (sosState is SosState.Active) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary,\n              modifier = Modifier.size(20.dp)\n            )\n            Spacer(modifier = Modifier.width(8.dp))\n            Text(\n              text = \"Guardian Protection\",\n              style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold)\n            )\n          }\n\n          Box(\n            modifier = Modifier\n              .clip(RoundedCornerShape(8.dp))\n              .background(\n                if (sosState is SosState.Active) MaterialTheme.colorScheme.error\n                else MaterialTheme.colorScheme.surfaceVariant\n              )\n              .padding(horizontal = 8.dp, vertical = 4.dp)\n          ) {\n            Text(\n              text = if (sosState is SosState.Active) \"ACTIVE\" else \"ARMED\",\n              color = if (sosState is SosState.Active) Color.White else MaterialTheme.colorScheme.onSurfaceVariant,\n              style = MaterialTheme.typography.labelSmall,\n              fontWeight = FontWeight.Bold\n            )\n          }\n        }\n\n        Spacer(modifier = Modifier.height(8.dp))\n\n        when (val current = sosState) {\n          is SosState.Idle -> {\n            Text(\n              text = \"Guardian is standing by in background. Ready for Duress PIN or Shake gesture. Emergency SMS and audio capture are armed.\",\n              style = MaterialTheme.typography.bodySmall,\n              color = MaterialTheme.colorScheme.onSurfaceVariant\n            )\n          }\n          is SosState.Active -> {\n            Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n              Text(\n                text = \"Trigger Source: ${current.triggerSource}\",\n                style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Bold),\n                color = MaterialTheme.colorScheme.error\n              )\n              Text(\n                text = \"Status: ${current.statusMessage}\",\n                style = MaterialTheme.typography.bodySmall\n              )\n              if (current.lastMapsUrl != null) {\n                Text(\n                  text = \"Live Location: ${current.lastMapsUrl}\",\n                  style = MaterialTheme.typography.bodySmall.copy(fontWeight = FontWeight.Medium),\n                  color = MaterialTheme.colorScheme.primary\n                )\n              }\n              Text(\n                text = \"Updates Dispatched: ${current.updateCount} (~2 min cadence)\",\n                style = MaterialTheme.typography.labelSmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant\n              )\n              Spacer(modifier = Modifier.height(8.dp))\n              Button(\n                onClick = { sosController.stopSos() },\n                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error),\n                modifier = Modifier.fillMaxWidth().testTag(\"stop_sos_settings_button\")\n              ) {\n                Text(\"Stop Active SOS Session\")\n              }\n            }\n          }\n        }\n      }\n    }\n  }"
        start_line: 833
        end_line: 842
      }
      num_matches: 1
    }
    description: "Add Guardian Protection status card to SettingsTabView"
