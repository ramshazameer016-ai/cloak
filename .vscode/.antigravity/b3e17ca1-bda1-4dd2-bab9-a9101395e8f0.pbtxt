              text: "            FilterChip("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              selected = selectedMood == m,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
