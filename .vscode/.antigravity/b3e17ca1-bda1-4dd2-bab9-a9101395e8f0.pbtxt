    content: "              style = MaterialTheme.typography.bodySmall,\n              color = MaterialTheme.colorScheme.onSurfaceVariant\n            )\n          }\n          is SosState.Active -> {\n            Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n              Text(\n                text = \"Trigger Source: ${current.triggerSource}\",\n                style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Bold),\n                color = MaterialTheme.colorScheme.error\n              )\n              Text(\n                text = \"Status: ${current.statusMessage}\",\n                style = MaterialTheme.typography.bodySmall\n              )\n              if (current.lastMapsUrl != null) {\n                Text(\n                  text = \"Live Location: ${current.lastMapsUrl}\",\n                  style = MaterialTheme.typography.bodySmall.copy(fontWeight = FontWeight.Medium),\n                  color = MaterialTheme.colorScheme.primary\n                )\n              }\n              Text(\n                text = \"Updates Dispatched: ${current.updateCount} (~2 min cadence)\",\n                style = MaterialTheme.typography.labelSmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant\n              )\n              Spacer(modifier = Modifier.height(8.dp))\n              Button(\n                onClick = { sosController.stopSos() },\n                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error),\n                modifier = Modifier.fillMaxWidth().testTag(\"stop_sos_settings_button\")\n              ) {\n                Text(\"Stop Active SOS Session\")\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n\n  if (showAddDialog) {\n    AlertDialog(\n      onDismissRequest = { showAddDialog = false },\n      title = { Text(\"Add Support Circle Contact\") },\n      text = {\n        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n          OutlinedTextField(\n            value = nameInput,\n            onValueChange = { nameInput = it },\n            label = { Text(\"Contact Name\") },\n            singleLine = true,\n            modifier = Modifier.fillMaxWidth()\n          )\n          OutlinedTextField(\n            value = phoneInput,\n            onValueChange = { phoneInput = it },\n            label = { Text(\"Phone Number\") },\n            singleLine = true,\n            modifier = Modifier.fillMaxWidth()\n          )\n          contactError?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall) }\n        }\n      },\n      confirmButton = {\n        Button(onClick = {\n          if (phoneInput.isBlank()) {\n            contactError = \"Phone number is required.\"\n            return@Button\n          }\n          scope.launch {\n            val res = contactRepository.addContact(nameInput, phoneInput)\n            res.onSuccess { showAddDialog = false }.onFailure { contactError = it.message }\n          }\n        }) {\n          Text(\"Save\")\n        }\n      },\n      dismissButton = {\n        OutlinedButton(onClick = { showAddDialog = false }) { Text(\"Cancel\") }\n      }\n    )\n  }\n}\n"
