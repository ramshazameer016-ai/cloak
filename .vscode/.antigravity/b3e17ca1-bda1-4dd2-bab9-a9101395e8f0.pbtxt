            lines {
              text: "    var dayCounter = 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    for (row in 0..5) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
