  code_action {
    action_spec {
      command {
        instruction: "Add DetailedContactDispatch and dispatchEmergencySmsDetailed"
        is_edit: true
        file {
          absolute_uri: "file:///app/src/main/java/com/example/core/telephony/SmsDispatcher.kt"
