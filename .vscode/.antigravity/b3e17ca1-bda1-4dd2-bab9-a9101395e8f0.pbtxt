        target_content: "  private fun startForegroundWithNotification() {\n    val notification: Notification = NotificationCompat.Builder(this, CHANNEL_ID)\n      .setContentTitle(\"Petal Health\")\n      .setContentText(\"Discreet background wellness sync in progress\")\n      .setSmallIcon(android.R.drawable.ic_menu_compass)\n      .setPriority(NotificationCompat.PRIORITY_LOW)\n      .setOngoing(true)\n      .build()\n\n    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {\n      val serviceTypes = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {\n        ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE or ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION\n      } else {\n        ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION\n      }\n      startForeground(NOTIFICATION_ID, notification, serviceTypes)\n    } else {\n      startForeground(NOTIFICATION_ID, notification)\n    }\n  }\n\n  private fun startAudioCapture() {\n    audioRecorder = AudioChunkRecorder(this, serviceScope) { chunkIndex, chunkFile ->\n      // Asynchronously upload completed chunk to Supabase Storage\n      serviceScope.launch(Dispatchers.IO) {\n        supabaseRepo.uploadAudioChunk(\n          sessionId = currentSessionId,\n          chunkIndex = chunkIndex,\n          audioFile = chunkFile\n        )\n      }\n    }\n    audioRecorder?.start(currentSessionId)\n  }"
        replacement_content: "  private fun startForegroundWithNotification() {\n    val notification: Notification = NotificationCompat.Builder(this, CHANNEL_ID)\n      .setContentTitle(\"Petal Health\")\n      .setContentText(\"Discreet background wellness sync in progress\")\n      .setSmallIcon(android.R.drawable.ic_menu_compass)\n      .setPriority(NotificationCompat.PRIORITY_LOW)\n      .setOngoing(true)\n      .build()\n\n    try {\n      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {\n        val hasMic = ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED\n        val hasLoc = ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||\n          ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED\n\n        var serviceTypes = 0\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R && hasMic) {\n          serviceTypes = serviceTypes or ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE\n        }\n        if (hasLoc) {\n          serviceTypes = serviceTypes or ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION\n        }\n\n        if (serviceTypes != 0) {\n          startForeground(NOTIFICATION_ID, notification, serviceTypes)\n        } else {\n          startForeground(NOTIFICATION_ID, notification)\n        }\n      } else {\n        startForeground(NOTIFICATION_ID, notification)\n      }\n    } catch (e: Exception) {\n      Log.w(\"SosForegroundService\", \"startForeground exception: ${e.message}, falling back\")\n      try {\n        startForeground(NOTIFICATION_ID, notification)\n      } catch (_: Exception) {}\n    }\n  }\n\n  private fun startAudioCapture() {\n    val hasMic = ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED\n    if (!hasMic) {\n      Log.d(\"SosForegroundService\", \"Audio capture skipped: RECORD_AUDIO permission not yet granted\")\n      return\n    }\n    audioRecorder = AudioChunkRecorder(this, serviceScope) { chunkIndex, chunkFile ->\n      // Asynchronously upload completed chunk to Supabase Storage\n      serviceScope.launch(Dispatchers.IO) {\n        supabaseRepo.uploadAudioChunk(\n          sessionId = currentSessionId,\n          chunkIndex = chunkIndex,\n          audioFile = chunkFile\n        )\n      }\n    }\n    audioRecorder?.start(currentSessionId)\n  }"
