    content: "      color = MaterialTheme.colorScheme.primary\n    )\n\n    // Flow Section\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Text(\"Flow Intensity\", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold))\n        Spacer(modifier = Modifier.height(8.dp))\n        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n          listOf(\"None\", \"Light\", \"Medium\", \"Heavy\").forEach { level ->\n            FilterChip(\n              selected = flowIntensity == level,\n              onClick = { flowIntensity = level },\n              label = { Text(level) }\n            )\n          }\n        }\n      }\n    }\n\n    // Symptoms Section\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Text(\"Symptoms\", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold))\n        Spacer(modifier = Modifier.height(8.dp))\n        val symptomList = listOf(\"Cramps\", \"Headache\", \"Bloating\", \"Fatigue\", \"Tender Breasts\", \"Acne\", \"Backache\", \"Cravings\")\n        LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n          items(symptomList) { sym ->\n            val isSelected = selectedSymptoms.value.contains(sym)\n            FilterChip(\n              selected = isSelected,\n              onClick = {\n                val current = selectedSymptoms.value.toMutableSet()\n                if (isSelected) current.remove(sym) else current.add(sym)\n                selectedSymptoms.value = current\n              },\n              label = { Text(sym) }\n            )\n          }\n        }\n      }\n    }\n\n    // Mood Section\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Text(\"Mood\", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold))\n        Spacer(modifier = Modifier.height(8.dp))\n        val moodList = listOf(\"Happy\", \"Calm\", \"Sensitive\", \"Irritable\", \"Exhausted\", \"Energetic\")\n        LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n          items(moodList) { m ->\n            FilterChip(\n              selected = selectedMood == m,\n              onClick = { selectedMood = m },\n              label = { Text(m) }\n            )\n          }\n        }\n      }\n    }\n\n    // Notes\n    OutlinedTextField(\n      value = notes,\n      onValueChange = { notes = it },\n      label = { Text(\"Personal Journal & Notes\") },\n      modifier = Modifier.fillMaxWidth(),\n      maxLines = 3\n    )\n\n    Button(\n      onClick = {\n        scope.launch {\n          val entry = PeriodEntry(\n            dateString = dateStr,\n            isPeriodDay = flowIntensity != \"None\",\n            flowIntensity = flowIntensity,\n            symptoms = selectedSymptoms.value.joinToString(\",\"),\n            mood = selectedMood,\n            notes = notes\n          )\n          periodRepository.saveEntry(entry)\n          saveConfirmed = true\n        }\n      },\n      modifier = Modifier.fillMaxWidth().height(50.dp)\n    ) {\n      Text(if (saveConfirmed) \"Saved \342\234\223\" else \"Save Wellness Log\")\n    }"
    num_lines: 985
    num_bytes: 38880
    line_range_bytes: 3560
  }
}
