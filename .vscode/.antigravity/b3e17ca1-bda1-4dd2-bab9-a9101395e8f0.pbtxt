            lines {
              text: "          items(symptomList) { sym ->"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            val isSelected = selectedSymptoms.value.contains(sym)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            FilterChip("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
