      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Wire KeypadScreen to AuthViewModel for robust PIN processing and clean architecture\", \"EndLine\":204, \"Instruction\":\"Update KeypadScreen to collect state and delegate clicks to AuthViewModel\", \"ReplacementContent\":\"@Composable\\nfun KeypadScreen(\\n  pinStorage: PinStorage,\\n  sosController: SosController,\\n  onUnlockSuccess: () -> Unit,\\n  viewModel: AuthViewModel = remember(pinStorage, sosController) {\\n    AuthViewModel(pinStorage, sosController)\\n  }\\n) {\\n  val enteredPin by viewModel.enteredPin.collectAsState()\\n  val errorMessage by viewModel.errorMessage.collectAsState()\\n\\n  LaunchedEffect(viewModel) {\\n    viewModel.unlockEvent.collect {\\n      onUnlockSuccess()\\n    }\\n  }\\n\\n  Surface(\\n    modifier = Modifier\\n      .fillMaxSize()\\n      .testTag(\\\"keypad_screen\\\"),\\n    color = MaterialTheme.colorScheme.background\\n  ) {\\n    Column(\\n      modifier = Modifier\\n        .fillMaxSize()\\n        .padding(24.dp)\\n        .widthIn(max = 480.dp),\\n      horizontalAlignment = Alignment.CenterHorizontally,\\n      verticalArrangement = Arrangement.SpaceBetween\\n    ) {\\n      // Header Section\\n      Column(\\n        horizontalAlignment = Alignment.CenterHorizontally,\\n        modifier = Modifier.padding(top = 40.dp)\\n      ) {\\n        Box(\\n          modifier = Modifier\\n            .size(64.dp)\\n            .clip(CircleShape)\\n            .background(MaterialTheme.colorScheme.primaryContainer),\\n          contentAlignment = Alignment.Center\\n        ) {\\n          Icon(\\n            imageVector = Icons.Default.Favorite,\\n            contentDescription = \\\"Petal Health Logo\\\",\\n            tint = MaterialTheme.colorScheme.primary,\\n            modifier = Modifier.size(32.dp)\\n          )\\n        }\\n\\n        Spacer(modifier = Modifier.height(16.dp))\\n\\n        Text(\\n          text = \\\"Petal\\\",\\n          style = MaterialTheme.typography.headlineMedium.copy(\\n            fontWeight = FontWeight.Bold,\\n            color = MaterialTheme.colorScheme.primary\\n          )\\n        )\\n\\n        Text(\\n          text = \\\"Enter your 4-digit health PIN\\\",\\n          style = MaterialTheme.typography.bodyMedium.copy(\\n            color = MaterialTheme.colorScheme.onSurfaceVariant\\n          ),\\n          modifier = Modifier.padding(top = 8.dp)\\n        )\\n\\n        Spacer(modifier = Modifier.height(28.dp))\\n\\n        // 4 PIN Dots\\n        Row(\\n          horizontalArrangement = Arrangement.spacedBy(16.dp),\\n          verticalAlignment = Alignment.CenterVertically\\n        ) {\\n          for (i in 0 until 4) {\\n            val isFilled = i < enteredPin.length\\n            Box(\\n              modifier = Modifier\\n                .size(18.dp)\\n                .clip(CircleShape)\\n                .background(\\n                  if (isFilled) MaterialTheme.colorScheme.primary\\n                  else MaterialTheme.colorScheme.surfaceVariant\\n                )\\n                .border(\\n                  width = 1.5.dp,\\n                  color = MaterialTheme.colorScheme.primary.copy(alpha = 0.5f),\\n                  shape = CircleShape\\n                )\\n            )\\n          }\\n        }\\n\\n        AnimatedVisibility(visible = errorMessage != null) {\\n          Text(\\n            text = errorMessage ?: \\\"\\\",\\n            color = MaterialTheme.colorScheme.error,\\n            style = MaterialTheme.typography.bodySmall,\\n            modifier = Modifier.padding(top = 16.dp),\\n            textAlign = TextAlign.Center\\n          )\\n        }\\n      }\\n\\n      // 3x4 Keypad Grid\\n      Column(\\n        modifier = Modifier\\n          .fillMaxWidth()\\n          .padding(bottom = 32.dp),\\n        verticalArrangement = Arrangement.spacedBy(16.dp),\\n        horizontalAlignment = Alignment.CenterHorizontally\\n      ) {\\n        val rows = listOf(\\n          listOf(\\\"1\\\", \\\"2\\\", \\\"3\\\"),\\n          listOf(\\\"4\\\", \\\"5\\\", \\\"6\\\"),\\n          listOf(\\\"7\\\", \\\"8\\\", \\\"9\\\"),\\n          listOf(\\\"CLEAR\\\", \\\"0\\\", \\\"BACK\\\")\\n        )\\n\\n        for (row in rows) {\\n          Row(\\n            modifier = Modifier.fillMaxWidth(),\\n            horizontalArrangement = Arrangement.SpaceEvenly\\n          ) {\\n            for (key in row) {\\n              KeypadButton(\\n                key = key,\\n                onClick = {\\n                  viewModel.onKeyClicked(key)\\n                }\\n              )\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\", \"StartLine\":44, \"TargetContent\":\"@Composable\\nfun KeypadScreen(\\n  pinStorage: PinStorage,\\n  sosController: SosController,\\n  onUnlockSuccess: () -> Unit\\n) {\\n  var enteredPin by remember { mutableStateOf(\\\"\\\") }\\n  var errorMessage by remember { mutableStateOf<String?>(null) }\\n\\n  // Auto-verify on 4th digit\\n  LaunchedEffect(enteredPin) {\\n    if (enteredPin.length == 4) {\\n      val result = pinStorage.verify(enteredPin)\\n      when (result) {\\n        is PinVerificationResult.NormalPinSuccess -> {\\n          // Normal PIN stops active SOS\\n          if (sosController.isSosActive) {\\n            sosController.stopSos()\\n          }\\n          onUnlockSuccess()\\n        }\\n        is PinVerificationResult.DuressPinSuccess -> {\\n          // Duress PIN silently triggers SOS in background\\n          sosController.startSos(triggerSource = \\\"duress_pin\\\")\\n          // Unlocks into the exact same disguise tracker UI\\n          onUnlockSuccess()\\n        }\\n        is PinVerificationResult.InvalidPin -> {\\n          errorMessage = \\\"Incorrect passcode. Please try again.\\\"\\n          enteredPin = \\\"\\\"\\n        }\\n      }\\n    }\\n  }\\n\\n  Surface(\\n    modifier = Modifier\\n      .fillMaxSize()\\n      .testTag(\\\"keypad_screen\\\"),\\n    color = MaterialTheme.colorScheme.background\\n  ) {\\n    Column(\\n      modifier = Modifier\\n        .fillMaxSize()\\n        .padding(24.dp)\\n        .widthIn(max = 480.dp),\\n      horizontalAlignment = Alignment.CenterHorizontally,\\n      verticalArrangement = Arrangement.SpaceBetween\\n    ) {\\n      // Header Section\\n      Column(\\n        horizontalAlignment = Alignment.CenterHorizontally,\\n        modifier = Modifier.padding(top = 40.dp)\\n      ) {\\n        Box(\\n          modifier = Modifier\\n            .size(64.dp)\\n            .clip(CircleShape)\\n            .background(MaterialTheme.colorScheme.primaryContainer),\\n          contentAlignment = Alignment.Center\\n        ) {\\n          Icon(\\n            imageVector = Icons.Default.Favorite,\\n            contentDescription = \\\"Petal Health Logo\\\",\\n            tint = MaterialTheme.colorScheme.primary,\\n            modifier = Modifier.size(32.dp)\\n          )\\n        }\\n\\n        Spacer(modifier = Modifier.height(16.dp))\\n\\n        Text(\\n          text = \\\"Petal\\\",\\n          style = MaterialTheme.typography.headlineMedium.copy(\\n            fontWeight = FontWeight.Bold,\\n            color = MaterialTheme.colorScheme.primary\\n          )\\n        )\\n\\n        Text(\\n          text = \\\"Enter your 4-digit health PIN\\\",\\n          style = MaterialTheme.typography.bodyMedium.copy(\\n            color = MaterialTheme.colorScheme.onSurfaceVariant\\n          ),\\n          modifier = Modifier.padding(top = 8.dp)\\n        )\\n\\n        Spacer(modifier = Modifier.height(28.dp))\\n\\n        // 4 PIN Dots\\n        Row(\\n          horizontalArrangement = Arrangement.spacedBy(16.dp),\\n          verticalAlignment = Alignment.CenterVertically\\n        ) {\\n          for (i in 0 until 4) {\\n            val isFilled = i < enteredPin.length\\n            Box(\\n              modifier = Modifier\\n                .size(18.dp)\\n                .clip(CircleShape)\\n                .background(\\n                  if (isFilled) MaterialTheme.colorScheme.primary\\n                  else MaterialTheme.colorScheme.surfaceVariant\\n                )\\n                .border(\\n                  width = 1.5.dp,\\n                  color = MaterialTheme.colorScheme.primary.copy(alpha = 0.5f),\\n                  shape = CircleShape\\n                )\\n            )\\n          }\\n        }\\n\\n        AnimatedVisibility(visible = errorMessage != null) {\\n          Text(\\n            text = errorMessage ?: \\\"\\\",\\n            color = MaterialTheme.colorScheme.error,\\n            style = MaterialTheme.typography.bodySmall,\\n            modifier = Modifier.padding(top = 16.dp),\\n            textAlign = TextAlign.Center\\n          )\\n        }\\n      }\\n\\n      // 3x4 Keypad Grid\\n      Column(\\n        modifier = Modifier\\n          .fillMaxWidth()\\n          .padding(bottom = 32.dp),\\n        verticalArrangement = Arrangement.spacedBy(16.dp),\\n        horizontalAlignment = Alignment.CenterHorizontally\\n      ) {\\n        val rows = listOf(\\n          listOf(\\\"1\\\", \\\"2\\\", \\\"3\\\"),\\n          listOf(\\\"4\\\", \\\"5\\\", \\\"6\\\"),\\n          listOf(\\\"7\\\", \\\"8\\\", \\\"9\\\"),\\n          listOf(\\\"CLEAR\\\", \\\"0\\\", \\\"BACK\\\")\\n        )\\n\\n        for (row in rows) {\\n          Row(\\n            modifier = Modifier.fillMaxWidth(),\\n            horizontalArrangement = Arrangement.SpaceEvenly\\n          ) {\\n            for (key in row) {\\n              KeypadButton(\\n                key = key,\\n                onClick = {\\n                  errorMessage = null\\n                  when (key) {\\n                    \\\"CLEAR\\\" -> enteredPin = \\\"\\\"\\n                    \\\"BACK\\\" -> if (enteredPin.isNotEmpty()) enteredPin = enteredPin.dropLast(1)\\n                    else -> if (enteredPin.length < 4) enteredPin += key\\n                  }\\n    