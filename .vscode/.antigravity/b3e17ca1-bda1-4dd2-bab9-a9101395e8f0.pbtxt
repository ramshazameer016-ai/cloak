    content: "\n// -------------------------------------------------------------\n// TAB 4: SETTINGS (Emergency Contacts, Cycle Settings, Fake Call)\n// -------------------------------------------------------------\n@OptIn(ExperimentalFoundationApi::class)\n@Composable\nprivate fun SettingsTabView(\n  contactRepository: ContactRepository,\n  periodRepository: PeriodRepository,\n  pinStorage: PinStorage,\n  onLaunchFakeCall: (String) -> Unit,\n  onResetPins: () -> Unit\n) {\n  val scope = rememberCoroutineScope()\n  val contacts by contactRepository.contactsFlow.collectAsState(initial = emptyList())\n  var cycleLength by remember { mutableIntStateOf(periodRepository.getAverageCycleLength()) }\n  var showAddDialog by remember { mutableStateOf(false) }\n  var nameInput by remember { mutableStateOf(\"\") }\n  var phoneInput by remember { mutableStateOf(\"\") }\n  var contactError by remember { mutableStateOf<String?>(null) }\n"
