              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  suspend fun saveEntry(entry: PeriodEntry) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    periodDao.insertOrUpdate(entry)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  suspend fun togglePeriodDay(date: LocalDate): Boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val dateStr = date.format(DATE_FORMATTER)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val existing = periodDao.getEntryByDate(dateStr)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val newIsPeriod = !(existing?.isPeriodDay ?: false)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val updated = existing?.copy(isPeriodDay = newIsPeriod) ?: PeriodEntry("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      dateString = dateStr,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      isPeriodDay = newIsPeriod,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      flowIntensity = if (newIsPeriod) \"Medium\" else \"\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    periodDao.insertOrUpdate(updated)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return newIsPeriod"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Predicts the next cycle window based on the most recent logged period date"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * and average cycle length."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  suspend fun predictNextPeriod(): Pair<LocalDate, LocalDate>? {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val periodDays = periodDao.getPeriodDays()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (periodDays.isEmpty()) return null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val dates = periodDays.mapNotNull {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      try {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        LocalDate.parse(it.dateString, DATE_FORMATTER)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } catch (_: Exception) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }.sortedDescending()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val lastPeriodStart = dates.firstOrNull() ?: return null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val cycleLength = getAverageCycleLength()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val duration = getPeriodDuration()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val predictedStart = lastPeriodStart.plusDays(cycleLength.toLong())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val predictedEnd = predictedStart.plusDays((duration - 1).toLong())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return Pair(predictedStart, predictedEnd)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///app/src/main/java/com/example/data/repository/PeriodRepository.kt"
        create_file: true
      }
