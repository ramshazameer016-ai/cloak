    content: "          listOf(\"CLEAR\", \"0\", \"BACK\")\n        )\n\n        for (row in rows) {\n          Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.SpaceEvenly\n          ) {\n            for (key in row) {\n              KeypadButton(\n                key = key,\n                onClick = {\n                  errorMessage = null\n                  when (key) {\n                    \"CLEAR\" -> enteredPin = \"\"\n                    \"BACK\" -> if (enteredPin.isNotEmpty()) enteredPin = enteredPin.dropLast(1)\n                    else -> if (enteredPin.length < 4) enteredPin += key\n                  }\n                }\n              )\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\n@Composable\nprivate fun KeypadButton(\n  key: String,\n  onClick: () -> Unit\n) {\n  Box(\n    modifier = Modifier\n      .size(76.dp)\n      .clip(CircleShape)\n      .background(\n        if (key == \"CLEAR\" || key == \"BACK\") MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)\n        else MaterialTheme.colorScheme.surfaceContainerHigh\n      )"
