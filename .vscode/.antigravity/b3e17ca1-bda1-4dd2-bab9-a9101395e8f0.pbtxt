    content: "            .background(Color(0xFF1B1112))\n        ) {\n          KeypadScreen(\n            pinStorage = pinStorage,\n            sosController = sosController,\n            onUnlockSuccess = {\n              isFakeSleepVisible = false\n              showUnlockKeypad = false\n              lastUserInteractionTime = System.currentTimeMillis()\n              if (!sosController.isSosActive) {\n                onNormalPinUnlocked()\n              } else {\n                onDuressPinUnlocked()\n              }\n            }\n          )\n        }\n      }\n    }\n  }\n}\n"
    num_lines: 121
    num_bytes: 3794
    line_range_bytes: 557
  }
}
