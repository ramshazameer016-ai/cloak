            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Modifier that triggers a secret callback only when the user holds"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * without moving more than 20 pixels for 3 full seconds."
