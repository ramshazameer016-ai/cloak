    content: "          )\n          if (contacts.size < 3) {\n            OutlinedButton(\n              onClick = {\n                nameInput = \"\"\n                phoneInput = \"\"\n                contactError = null\n                showAddDialog = true\n              },\n              modifier = Modifier.testTag(\"settings_add_contact_button\")\n            ) {\n              Icon(Icons.Default.Add, contentDescription = null, modifier = Modifier.size(16.dp))\n              Spacer(modifier = Modifier.width(4.dp))\n              Text(\"Add\")\n            }\n          }\n        }\n\n        Spacer(modifier = Modifier.height(10.dp))\n\n        if (contacts.isEmpty()) {\n          Text(\n            text = \"No emergency contacts set. Configure up to 3 trusted contacts.\",\n            style = MaterialTheme.typography.bodySmall,\n            color = MaterialTheme.colorScheme.onSurfaceVariant\n          )\n        } else {\n          contacts.forEach { contact ->\n            Row(\n              modifier = Modifier\n                .fillMaxWidth()\n                .padding(vertical = 4.dp),\n              horizontalArrangement = Arrangement.SpaceBetween,\n              verticalAlignment = Alignment.CenterVertically\n            ) {\n              Column {\n                Text(contact.name, style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Bold))\n                Text(contact.phoneNumber, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n              }\n              IconButton(onClick = { scope.launch { contactRepository.deleteContact(contact.id) } }) {\n                Icon(Icons.Default.Delete, contentDescription = \"Delete\", tint = MaterialTheme.colorScheme.error)\n              }\n            }\n          }\n        }\n      }\n    }\n\n    // Cycle Settings\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Text(\"Average Cycle Length: $cycleLength days\", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold))\n        Slider(\n          value = cycleLength.toFloat(),\n          onValueChange = {\n            cycleLength = it.toInt()\n            periodRepository.setAverageCycleLength(cycleLength)\n          },\n          valueRange = 21f..35f,\n          steps = 13\n        )\n        Text(\"Standard default is 28 days for cycle prediction.\", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n      }\n    }\n\n    // Privacy & Security Reset\n    Card(\n      modifier = Modifier.fillMaxWidth(),\n      colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f)),\n      shape = RoundedCornerShape(16.dp)\n    ) {\n      Row(\n        modifier = Modifier.fillMaxWidth().padding(16.dp),\n        horizontalArrangement = Arrangement.SpaceBetween,\n        verticalAlignment = Alignment.CenterVertically\n      ) {\n        Column {\n          Text(\"Security Reset\", style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Bold))\n          Text(\"Reset access PINs & onboarding.\", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n        }\n        OutlinedButton(onClick = {\n          pinStorage.clearAll()\n          onResetPins()\n        }) {\n          Text(\"Reset PINs\")\n        }\n      }\n    }\n\n    // Guardian Protection Status Card (Discreet Verification in Settings)\n    Card(\n      modifier = Modifier\n        .fillMaxWidth()\n        .testTag(\"guardian_status_card\"),\n      colors = CardDefaults.cardColors(\n        containerColor = if (sosState is SosState.Active)\n          MaterialTheme.colorScheme.errorContainer.copy(alpha = 0.25f)\n        else MaterialTheme.colorScheme.surface\n      ),\n      shape = RoundedCornerShape(16.dp),\n      elevation = CardDefaults.cardElevation(defaultElevation = 1.dp)\n    ) {\n      Column(modifier = Modifier.padding(16.dp)) {\n        Row(\n          modifier = Modifier.fillMaxWidth(),\n          horizontalArrangement = Arrangement.SpaceBetween,\n          verticalAlignment = Alignment.CenterVertically\n        ) {\n          Row(verticalAlignment = Alignment.CenterVertically) {\n            Icon(\n              imageVector = if (sosState is SosState.Active) Icons.Default.NotificationsActive else Icons.Default.Security,\n              contentDescription = null,\n              tint = if (sosState is SosState.Active) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary,\n              modifier = Modifier.size(20.dp)\n            )\n            Spacer(modifier = Modifier.width(8.dp))\n            Text(\n              text = \"Guardian Protection\",\n              style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold)\n            )\n          }\n\n          Box(\n            modifier = Modifier\n              .clip(RoundedCornerShape(8.dp))\n              .background(\n                if (sosState is SosState.Active) MaterialTheme.colorScheme.error\n                else MaterialTheme.colorScheme.surfaceVariant\n              )\n              .padding(horizontal = 8.dp, vertical = 4.dp)\n          ) {\n            Text(\n              text = if (sosState is SosState.Active) \"ACTIVE\" else \"ARMED\",\n              color = if (sosState is SosState.Active) Color.White else MaterialTheme.colorScheme.onSurfaceVariant,\n              style = MaterialTheme.typography.labelSmall,\n              fontWeight = FontWeight.Bold\n            )\n          }\n        }\n\n        Spacer(modifier = Modifier.height(8.dp))\n\n        when (val current = sosState) {\n          is SosState.Idle -> {\n            Text(\n              text = \"Guardian is standing by in background. Ready for Duress PIN or Shake gesture. Emergency SMS and audio capture are armed.\",\n              style = MaterialTheme.typography.bodySmall,"
